<Project>
  <PropertyGroup>
    <BuildCoreMlBridge Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64' Or '$(RuntimeIdentifier)' == 'osx-arm64')">true</BuildCoreMlBridge>
    <CoreMlBridgeOutput>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)neural/libwhisper.coreml.dylib</CoreMlBridgeOutput>
  </PropertyGroup>
  <Target Name="CompileCoreMlBridge" Condition="'$(BuildCoreMlBridge)' == 'true'"
          Inputs="$(MSBuildThisFileDirectory)CoreMlBridge.mm;$(MSBuildThisFileFullPath)" Outputs="$(CoreMlBridgeOutput)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(CoreMlBridgeOutput)'))" />
    <Exec Command="xcrun clang++ -target arm64-apple-macosx15.0 -dynamiclib -fobjc-arc -std=c++17 -framework Foundation -framework CoreML -install_name @rpath/libwhisper.coreml.dylib &quot;$(MSBuildThisFileDirectory)CoreMlBridge.mm&quot; -o &quot;$(CoreMlBridgeOutput)&quot;" />
  </Target>
  <Target Name="SelectCoreMlBridge" BeforeTargets="AssignTargetPaths" DependsOnTargets="CompileCoreMlBridge">
    <Error Condition="'$(RuntimeIdentifier)' == 'osx-arm64' And '$(BuildCoreMlBridge)' != 'true'" Text="Build the Apple silicon speech runtime on a Mac with Xcode tools." />
    <ItemGroup Condition="'$(BuildCoreMlBridge)' == 'true'">
      <None Remove="@(None)" Condition="'%(None.TargetPath)' == 'runtimes/coreml/macos-arm64/libwhisper.coreml.dylib'" />
      <None Include="$(CoreMlBridgeOutput)" TargetPath="runtimes/coreml/macos-arm64/libwhisper.coreml.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
