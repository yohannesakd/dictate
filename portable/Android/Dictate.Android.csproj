<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <ApplicationId>dev.local.dictate.portable</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidSpeechAbi Condition="'$(RuntimeIdentifier)' == 'android-arm64'">arm64-v8a</AndroidSpeechAbi>
    <AndroidSpeechAbi Condition="'$(RuntimeIdentifier)' == 'android-x64'">x86_64</AndroidSpeechAbi>
    <AndroidSpeechDirectory Condition="'$(AndroidSpeechDirectory)' == ''">$(MSBuildProjectDirectory)/../.tools/android-speech/lib</AndroidSpeechDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Dictate.Core.csproj" />
    <ProjectReference Include="../Speech/Dictate.Speech.csproj" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup><AndroidAsset Include="../Speech/Licenses/*" Link="Licenses/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="$(AndroidSpeechDirectory)/../licenses/*" Exclude="$(AndroidSpeechDirectory)/../licenses/whisper.cpp-LICENSE.txt" Link="Licenses/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="../../desktop/ui/index.html;../../desktop/ui/styles.css;../../desktop/ui/app.js;../../desktop/ui/android.js" Link="ui/%(Filename)%(Extension)" />
    <AndroidAsset Include="../../desktop/ui/fonts/*" Link="ui/fonts/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'"><Compile Include="../Checks/SpeechEvaluation.cs" Link="SpeechEvaluation.cs" /></ItemGroup>
  <Target Name="SelectAndroidSpeechLibraries" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AndroidSpeechAbi)' == ''" Text="Select android-arm64 or android-x64." />
    <Error Condition="!Exists('$(AndroidSpeechDirectory)/$(AndroidSpeechAbi)/libwhisper.so')" Text="Build Android speech libraries with portable/scripts/build-android.sh." />
    <ItemGroup>
      <AndroidNativeLibrary Remove="@(AndroidNativeLibrary)" Condition="$([System.String]::Copy('%(AndroidNativeLibrary.Identity)').Contains('whisper.net.runtime'))" />
      <AndroidNativeLibrary Include="$(AndroidSpeechDirectory)/$(AndroidSpeechAbi)/*.so" Abi="$(AndroidSpeechAbi)" />
    </ItemGroup>
  </Target>
  <ItemGroup><AndroidAsset Include="../../LICENSE" Link="Licenses/Dictate-LICENSE.txt" /></ItemGroup>
</Project>
