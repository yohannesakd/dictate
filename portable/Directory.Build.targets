<Project>
  <PropertyGroup>
    <SpeechRuntime Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-')) Or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">$(RuntimeIdentifier)</SpeechRuntime>
    <SpeechRuntime Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">$([System.String]::Copy('$(RuntimeIdentifier)').Replace('osx-', 'macos-'))</SpeechRuntime>
  </PropertyGroup>
  <!-- Keep CPU, no-AVX, and accelerator libraries for the published platform only. -->
  <Target Name="SelectSpeechRuntime" AfterTargets="ComputeFilesToPublish" Condition="'$(SpeechRuntime)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes/')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes/$(SpeechRuntime)/')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes/noavx/$(SpeechRuntime)/')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes/vulkan/$(SpeechRuntime)/')) And !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes/openvino/$(SpeechRuntime)/'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'$(Configuration)' == 'Release' And '%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
